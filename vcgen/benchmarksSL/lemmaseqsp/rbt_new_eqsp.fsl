(Function key   Loc Int)
(Function color Loc Int)
(Function left  Loc Loc)
(Function right Loc Loc)

(RecFunction Keys Loc SetInt)
(RecFunction Min  Loc Int)
(RecFunction Max  Loc Int)
(Var plus_infty Int)
(Var minus_infty Int)

(RecFunction BH Loc Int)
(RecFunction RBT  Loc Bool)

(Var x Loc)

(RecDef (Min x) (ite (= x nil) plus_infty
                (ite (<= (key x) (Min (left x)))
                  (ite (<= (key x) (Min (right x)))
                    (key x)
                    (Min (right x))
                  )
                  (ite (<= (Min (left x)) (Min (right x)))
                    (Min (left x))
                    (Min (right x))
                  )
                )))
(RecDef (Max x) (ite (= x nil) minus_infty
                (ite (>= (key x) (Max (left x)))
                  (ite (>= (key x) (Max (right x)))
                    (key x)
                    (Max (right x))
                  )
                  (ite (>= (Max (left x)) (Max (right x)))
                    (Max (left x))
                    (Max (right x))
                  )
                )))

(RecDef (BH x) (ite (= x nil) (IntConst 1)
               (ite (= (color x) (IntConst 1))
                    (+ (IntConst 1)
                      (ite (< (BH (left x)) (BH (right x)))
                        (BH (right x)) (BH (left x))))
                    (ite (< (BH (left x)) (BH (right x)))
                      (BH (right x)) (BH (left x))))))

(RecDef (RBT x) (ite (= x nil) True 
                    (and (= (BH (left x)) (BH (right x)))
                      (Exists (= lft (left x)) (= rht (right x)) (= k (key x)) (= cx (color x))
                                (and 
                                (* (* (* (= k (key x)) (and (< k plus_infty) (< minus_infty k)) ) 
                                (and (RBT lft) (< (Max lft) k))) (and (RBT rht) (< k (Min rht))))
                                
                                (ite (= cx (IntConst 1)) (* (= (key x) (key x)) (* (RBT lft) (RBT rht)) )
                                        (* (= (key x) (key x))
                                        (* (ite (= lft nil) True (Exists (= llft (left lft)) (= rlft (right lft)) 
                                              (* (= (color lft) (IntConst 1)) (* (RBT llft) (RBT rlft)))  
                                        ))
                                        (ite (= rht nil) True (Exists (= lrht (left rht)) (= rrht (right rht)) 
                                              (* (= (color rht) (IntConst 1)) (* (RBT lrht) (RBT rrht)))  
                                        ))
                                        ))
                                )
                          )
                        )
                      )    
                ))


(RecDef (Keys x) (ite (= x nil) EmptySetInt
                      (SetAdd (SetUnion (Keys (left x)) (Keys (right x)))
                              (key x))))

(RecFunction IndStruct Loc Bool)
(RecDef (IndStruct x) (ite (= x nil) True (and (IndStruct (left x)) (IndStruct (right x)))))

(lemma (x) (=> (IndStruct x) (and (= (Sp (RBT x)) (Sp (Keys x))) (= (Sp (RBT x)) (Sp (BH x)))
                                  (= (Sp (RBT x)) (Sp (Min x))) (= (Sp (RBT x)) (Sp (Max x)))
                              )
))  


(Var ret Loc)
(Program temp (x) (ret))
(Pre True)
(Post True)
(return)