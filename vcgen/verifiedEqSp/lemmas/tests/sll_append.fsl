(Var x Loc)

(Function next Loc Loc)
(Function key  Loc Int)

(EqSp (List (Keys Length)))
(RecFunction List Loc Bool)
(RecFunction Keys Loc SetInt)
(RecFunction Length Loc Int)

(RecDef (List x) (ite (= x nil) True
                      (and (List (next x))
                           (not (IsMember x (Sp (List (antiSp (next x)))))))))
(RecDef (Keys x) (ite (= x nil) EmptySetInt
                      (SetAdd (Keys (next x)) (key x))))

(RecDef (Length x) (ite (= x nil) (IntConst 0)
                (+ (IntConst 1) (Length (next x)))
))

(Var y Loc)
(Var aux Loc)
(Var tmp Loc)
(Var ret Loc)

(Program lemma (x) (ret))
(Pre (List x))
(Post (<= (IntConst 0) (Length x)))
(If (= x nil)
Then
(return)
Else
(assume (<= (IntConst 0) (Length (next x))))
(return)
)

