(Var x   Loc)

(Function next Loc Loc)
(Function key  Loc Int)

(Var plus_infty Int)


(RecFunction Min Loc Int)
(RecDef (Min x) (ite (= x nil) plus_infty (ite (< (key x) (Min (next x))) (key x) (Min (next x)))))

(Var minus_infty Int)
(RecFunction Max Loc Int)
(RecDef (Max x) (ite (= x nil) minus_infty (ite (> (key x) (Max (next x))) (key x) (Max (next x)))))

(RecFunction List   Loc Bool)
(RecFunction Keys   Loc SetInt)
(RecFunction Sorted Loc Bool)

(RecDef (List x) (ite (= x nil) True
                      (and (< (key x) plus_infty) (< minus_infty (key x)) (List (next x))
                           (not (IsMember x (Sp (List (antiSp (next x)))))))))
(RecDef (Keys x) (ite (= x nil) EmptySetInt
                 (SetAdd (Keys (next x)) (key x))))
(RecDef (Sorted x) (ite (= x nil) True
                      (and (< (key x) plus_infty) (< minus_infty (key x)) (Sorted (next x))
                           (not (IsMember x (Sp (Sorted (antiSp (next x))))))
                           (<= (key x) (Min (next x))))))


(Program temp1 (x) (ret))
(Pre (ite (= x nil) True (= (Sp (List (antiSp (next x)))) (Sp (Keys (antiSp (next x)))))))
(Post (= (Sp (List x)) (Sp (Keys x))))
(return)

(Program temp1 (x) (ret))
(Pre (ite (= x nil) True (= (Sp (Max (antiSp (next x)))) (Sp (Keys (antiSp (next x)))))))
(Post (= (Sp (Max x)) (Sp (Keys x))))
(return)

(Program temp2 (x) (ret))
(Pre (ite (= x nil) True (= (Sp (Min (antiSp (next x)))) (Sp (Keys (antiSp (next x)))))))
(Post (= (Sp (Min x)) (Sp (Keys x))))
(return)

(Program temp3 (x) (ret))
(Pre (ite (= x nil) True (and (= (Sp (Sorted (antiSp (next x)))) (Sp (Keys (antiSp (next x)))))
                              (= (Sp (Min x)) (Sp (Keys x)))
)))
(Post (= (Sp (Sorted x)) (Sp (Keys x))))
(return)