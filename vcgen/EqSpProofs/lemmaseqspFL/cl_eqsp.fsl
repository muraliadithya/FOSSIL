(Function next Loc Loc)
(Function key  Loc Int)



(RecFunction Lseg Loc Loc Bool)
(RecFunction Circ Loc Bool)
(RecFunction CKys Loc Loc SetInt)
(RecFunction Keys Loc SetInt)

(Var x Loc)
(Var y Loc)



(RecDef (Lseg x y) (ite (= x y) True
                   (ite (= x nil) False
                        (and (Lseg (next x) y)
                             (not (IsMember x (Sp (Lseg (antiSp (next x)) y)))) ))))
(RecDef (CKys x y) (ite (= x y) EmptySetInt (ite (= x nil) EmptySetInt
                        (SetAdd (CKys (next x) y) (key x)))))

(RecDef (Circ x) (ite (= x nil) True
                 (and (Lseg (next x) x)
                      (not (IsMember x (Sp (Lseg (antiSp (next x)) (antiSp x))))) )))
(RecDef (Keys x) (ite (= x nil) EmptySetInt
                      (SetAdd (CKys (next x) x) (key x))))

(Var k Int)
(Var ret Bool)



(Program temp0 (x y) (ret))
(Pre (ite (= x y) True (ite (= x nil) True (= (Sp (Lseg (antiSp (next x)) y)) (Sp (CKys (antiSp (next x)) y))) )))
(Post (= (Sp (Lseg x y)) (Sp (CKys x y))))
(return)




(Program temp (x) (ret))
(Pre (ite (= x nil) True (= (Sp (Lseg (antiSp (next x)) (antiSp x))) (Sp (CKys (antiSp (next x)) (antiSp x)))) ))
(Post (= (Sp (Circ x)) (Sp (Keys x))))
(return)