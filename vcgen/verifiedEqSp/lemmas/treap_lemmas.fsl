(Function key   Loc Int)
(Function prio  Loc Int)
(Function left  Loc Loc)
(Function right Loc Loc)

(EqSp (Keys (MinKey MaxKey MaxPrio Treap Priorities)))


(RecFunction Keys       Loc SetInt)
(RecFunction MinKey  Loc Int)
(RecFunction MaxKey  Loc Int)
(RecFunction MaxPrio Loc Int)
(RecFunction Treap      Loc Bool)
(RecFunction Priorities Loc SetInt)

(Var x Loc)
(Var plus_infty Int)
(Var minus_infty Int)

(RecDef (MinKey x)
  (ite (= x nil) plus_infty
    (ite (<= (key x) (MinKey (left x)))
      (ite (<= (key x) (MinKey (right x)))
        (key x)
        (MinKey (right x))
      )
      (ite (<= (MinKey (left x)) (MinKey (right x)))
        (MinKey (left x))
        (MinKey (right x))))))

(RecDef (MaxKey x)
  (ite (= x nil) minus_infty
    (ite (>= (key x) (MaxKey (left x)))
      (ite (>= (key x) (MaxKey (right x)))
        (key x)
        (MaxKey (right x))
      )
      (ite (>= (MaxKey (left x)) (MaxKey (right x)))
        (MaxKey (left x))
        (MaxKey (right x))))))
(RecDef (MaxPrio x)
  (ite (= x nil) minus_infty
    (ite (>= (prio x) (MaxPrio (left x)))
      (ite (>= (prio x) (MaxPrio (right x)))
        (prio x)
        (MaxPrio (right x))
      )
      (ite (>= (MaxPrio (left x)) (MaxPrio (right x)))
        (MaxPrio (left x))
        (MaxPrio (right x))))))

(RecDef (Treap x)
  (ite (= x nil) True
    (and (< minus_infty (key x)) (< (key x) plus_infty)
    (< minus_infty (prio x)) (< (prio x) plus_infty)
    (Treap (left x))  (< (MaxKey (left x)) (key x))  (< (MaxPrio (left x)) (prio x))
         (Treap (right x)) (< (key x) (MinKey (right x))) (< (MaxPrio (right x)) (prio x))
         (= EmptySetInt (SetIntersect (Priorities (left x)) (Priorities (right x))))
         (not (IsMember x (Sp (Treap (antiSp (left x))))))
         (not (IsMember x (Sp (Treap (antiSp (right x))))))
         (= EmptySetLoc (SetIntersect (Sp (Treap (antiSp (left x))))
                                      (Sp (Treap (antiSp (right x))))))
         )))

(RecDef (Keys x)
  (ite (= x nil) EmptySetInt
    (SetAdd (SetUnion (Keys (left x)) (Keys (right x))) (key x))))
(RecDef (Priorities x)
  (ite (= x nil) EmptySetInt
    (SetAdd (SetUnion (Priorities (left x)) (Priorities (right x))) (prio x))))

(Var k Int)
(Var p Int)
(Var ret Loc)
(Var lft Loc)
(Var rht Loc)


(Program lemma3 (x) (ret))
(Pre (Treap x))
(Post (and (Treap x) (Treap ret) (=> (not (= x nil)) (= (MaxPrio x) (prio x)))))
(assume (not (= x nil)))
(assign lft (left x))
(assign rht (right x))
(call lemma3 (lft) (ret))
(assign ret (lft))
(call lemma3 (rht) (ret))
(return)



(Program lemma1 (x k) (ret))
(Pre (Treap x))
(Post (=> (< k (MinKey x)) (not (IsMember k (Keys x)))))
(If (= x nil)
Then
(return)
Else
(assign lft (left x))
(assign rht (right x))
(call lemma1 (lft k) (ret))
(call lemma1 (rht k) (ret))
(return)
)

(Program lemma2 (x p) (ret))
(Pre (Treap x))
(Post (=> (> p (MaxPrio x)) (not (IsMember p (Priorities x)))))
(If (= x nil)
Then
(return)
Else
(assign lft (left x))
(assign rht (right x))
(call lemma2 (lft p) (ret))
(call lemma2 (rht p) (ret))
(return)
)


(Program lemma4 (x k) (ret))
(Pre (Treap x))
(Post (=> (> k (MaxKey x)) (not (IsMember k (Keys x)))))
(If (= x nil)
Then
(return)
Else
(assign lft (left x))
(assign rht (right x))
(call lemma4 (lft k) (ret))
(call lemma4 (rht k) (ret))
(return)
)