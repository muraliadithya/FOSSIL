(Function key   Loc Int)
(Function prio  Loc Int)
(Function left  Loc Loc)
(Function right Loc Loc)

(RecFunction Keys       Loc SetInt)
(RecFunction MinKey  Loc Int)
(RecFunction MaxKey  Loc Int)
(RecFunction MaxPrio Loc Int)
(RecFunction Treap      Loc Bool)
(RecFunction Priorities Loc SetInt)

(Var x Loc)
(Var rht Loc)
(Var lft Loc)
(Var p Int)
(Var k Int)
(Var plus_infty Int)
(Var minus_infty Int)

(RecDef (MinKey x)
  (ite (= x nil) plus_infty
    (ite (<= (key x) (MinKey (left x)))
      (ite (<= (key x) (MinKey (right x)))
        (key x)
        (MinKey (right x))
      )
      (ite (<= (MinKey (left x)) (MinKey (right x)))
        (MinKey (left x))
        (MinKey (right x))))))

(RecDef (MaxKey x)
  (ite (= x nil) minus_infty
    (ite (>= (key x) (MaxKey (left x)))
      (ite (>= (key x) (MaxKey (right x)))
        (key x)
        (MaxKey (right x))
      )
      (ite (>= (MaxKey (left x)) (MaxKey (right x)))
        (MaxKey (left x))
        (MaxKey (right x))))))

(RecDef (MaxPrio x)
  (ite (= x nil) minus_infty
    (ite (>= (prio x) (MaxPrio (left x)))
      (ite (>= (prio x) (MaxPrio (right x)))
        (prio x)
        (MaxPrio (right x))
      )
      (ite (>= (MaxPrio (left x)) (MaxPrio (right x)))
        (MaxPrio (left x))
        (MaxPrio (right x))))))

(RecDef (Keys x)
  (ite (= x nil) EmptySetInt
    (SetAdd (SetUnion (Keys (left x)) (Keys (right x))) (key x))))
(RecDef (Priorities x)
  (ite (= x nil) EmptySetInt
    (SetAdd (SetUnion (Priorities (left x)) (Priorities (right x))) (prio x))))

(RecDef (Treap x) (ite (= x nil) True (and (Exists (= lft (left x)) (Exists (= rht (right x)) (Exists (= k (key x)) (Exists (= p (prio x))
                                (* (and (< k plus_infty) (and (< minus_infty k) (and (< p plus_infty) (< minus_infty p))))
                                    (* (= k (key x)) (* (and (Treap lft) (and (< (MaxKey lft) k) (< (MaxPrio lft) p)))
                                                        (and (Treap rht) (and (< k (MinKey rht)) (< (MaxPrio rht) p))))))
                                    ))))
                                    (= EmptySetInt (SetIntersect (Priorities (left x)) (Priorities (right x))))
)
                ))

(Var ret Loc)
(Program temp1 (x) (ret))
(Pre (ite (= x nil) True (and (= (Sp (MaxKey (antiSp (left x)))) (Sp (Keys (antiSp (left x)))))
                              (= (Sp (MaxKey (antiSp (right x)))) (Sp (Keys (antiSp (right x)))))
)))
(Post (= (Sp (MaxKey x)) (Sp (Keys x))))
(return)

(Program temp2 (x) (ret))
(Pre (ite (= x nil) True (and (= (Sp (MinKey (antiSp (left x)))) (Sp (Keys (antiSp (left x)))))
                              (= (Sp (MinKey (antiSp (right x)))) (Sp (Keys (antiSp (right x)))))
)))
(Post (= (Sp (MinKey x)) (Sp (Keys x))))
(return)

(Program temp3 (x) (ret))
(Pre (ite (= x nil) True (and (= (Sp (MaxPrio (antiSp (left x)))) (Sp (Keys (antiSp (left x)))))
                              (= (Sp (MaxPrio (antiSp (right x)))) (Sp (Keys (antiSp (right x)))))
)))
(Post (= (Sp (MaxPrio x)) (Sp (Keys x))))
(return)

(Program temp4 (x) (ret))
(Pre (ite (= x nil) True (and (= (Sp (Priorities (antiSp (left x)))) (Sp (Keys (antiSp (left x)))))
                              (= (Sp (Priorities (antiSp (right x)))) (Sp (Keys (antiSp (right x)))))
)))
(Post (= (Sp (Priorities x)) (Sp (Keys x))))
(return)


(Program temp5 (x) (ret))
(Pre (ite (= x nil) True (and (= (Sp (Treap (antiSp (left x)))) (Sp (Keys (antiSp (left x)))))
                              (= (Sp (Treap (antiSp (right x)))) (Sp (Keys (antiSp (right x)))))
                              (= (Sp (MinKey x)) (Sp (Keys x)) )
                              (= (Sp (MaxKey x)) (Sp (Keys x)) )
                              (= (Sp (MaxPrio x)) (Sp (Keys x)) )
                              (= (Sp (Priorities x)) (Sp (Keys x)) )
)))
(Post (= (Sp (Treap x)) (Sp (Keys x))))
(return)