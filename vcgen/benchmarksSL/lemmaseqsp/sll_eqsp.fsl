(Var x Loc)

(Function next Loc Loc)
(Function key  Loc Int)

(RecFunction List Loc Bool)
(RecFunction Keys Loc SetInt)

(RecDef (Keys x) (ite (= x nil) EmptySetInt
                      (SetAdd (Keys (next x)) (key x))))

(RecDef (List x) (ite (= x nil) True
                    (Exists (= y (next x)) (* (= (next x) (next x)) (List y)))
               ))



(RecFunction IndStruct Loc Bool)
(RecDef (IndStruct x) (ite (= x nil) True (IndStruct (next x))))

(Var y Loc)
(Var aux Loc)
(Var tmp Loc)
(Var ret Loc)


(lemma (x) (=> (IndStruct x) (= (Sp (List x)) (Sp (Keys x))))
)

(Program temp (x) (ret))
(Pre True)
(Post True)
(return)
